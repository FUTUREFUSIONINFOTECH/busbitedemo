import { useMemo, useState } from 'react';
import {
  Bus,
  CheckCircle2,
  Home,
  Route,
  MapPinned,
  ClipboardList,
  UserRound,
  Clock,
  Compass,
  MapPin,
  Navigation,
  Play,
  Square,
  Users,
  Wifi,
  WifiOff,
  Bell,
  ChevronDown,
} from 'lucide-react';
import { RouteMapVisualizer } from '../components/RouteMapVisualizer';
import type { PlatformState } from '../types/platform';

interface DriverPortalProps {
  state: PlatformState;
  post: <T = unknown>(url: string, body?: unknown) => Promise<T>;
  patch: <T = unknown>(url: string, body?: unknown) => Promise<T>;
}

export function DriverPortal({ state, post, patch }: DriverPortalProps) {
  const [selectedTripId, setSelectedTripId] = useState<string>(state.trips[0]?.id || 'trip-1');
  const [activeTab, setActiveTab] = useState<'home' | 'trips' | 'gps' | 'orders' | 'profile'>('home');
  const [crewMode, setCrewMode] = useState<'DRIVER' | 'CONDUCTOR'>('DRIVER');
  const [speedKmh, setSpeedKmh] = useState<number>(68);
  const [offlineMode, setOfflineMode] = useState<boolean>(false);
  const [queuedUpdates, setQueuedUpdates] = useState<{ progressPct: number; speedKmh: number; ts: string }[]>([]);
  const [busy, setBusy] = useState<boolean>(false);
  const [statusMessage, setStatusMessage] = useState<string | null>(null);

  const trip = useMemo(
    () => state.trips.find((t) => t.id === selectedTripId) || state.trips[0],
    [state.trips, selectedTripId]
  );

  const vehicle = useMemo(
    () => state.vehicles.find((v) => v.id === trip?.vehicleId),
    [state.vehicles, trip]
  );

  const route = useMemo(
    () => state.routes.find((r) => r.id === trip?.routeId),
    [state.routes, trip]
  );

  const driver = useMemo(
    () => state.staff.find((s) => s.id === trip?.driverId),
    [state.staff, trip]
  );

  const conductor = useMemo(
    () => state.staff.find((s) => s.id === trip?.conductorId),
    [state.staff, trip]
  );

  const company = useMemo(
    () => state.companies.find((c) => c.id === vehicle?.companyId),
    [state.companies, vehicle]
  );

  const tripOrders = useMemo(
    () =>
      state.orders.filter(
        (o) =>
          o.tripId === trip?.id &&
          o.paymentStatus === 'VERIFIED' &&
          o.status !== 'REJECTED' &&
          o.status !== 'CANCELLED'
      ),
    [state.orders, trip]
  );

  const nextRestaurantStop = useMemo(() => {
    if (!trip) return null;
    return trip.stopEtas.find((s) => s.restaurantId && !s.passed) || null;
  }, [trip]);

  const nextRestaurant = useMemo(
    () =>
      nextRestaurantStop?.restaurantId
        ? state.restaurants.find((r) => r.id === nextRestaurantStop.restaurantId)
        : null,
    [nextRestaurantStop, state.restaurants]
  );

  if (!trip || !vehicle || !route) return null;

  const pushGpsUpdate = async (nextPct: number) => {
    const clamped = Math.max(0, Math.min(100, nextPct));
    if (trip.status !== 'IN_PROGRESS') return;

    if (offlineMode) {
      setQueuedUpdates((prev) => [
        ...prev,
        { progressPct: clamped, speedKmh, ts: new Date().toLocaleTimeString() },
      ]);
      setStatusMessage(`Offline buffer: saved GPS point (${clamped}%) locally for sync.`);
      return;
    }

    setBusy(true);
    try {
      await post(`/api/trips/${trip.id}/gps`, { progressPct: clamped, speedKmh });
      setStatusMessage(`GPS telemetry synced (${clamped}% corridor progress).`);
    } finally {
      setBusy(false);
    }
  };

  const handleToggleOffline = async () => {
    if (offlineMode) {
      // Reconnecting: flush buffered GPS queue safely
      setOfflineMode(false);
      if (queuedUpdates.length > 0 && trip.status === 'IN_PROGRESS') {
        const latest = queuedUpdates[queuedUpdates.length - 1];
        setBusy(true);
        try {
          await post(`/api/trips/${trip.id}/gps`, {
            progressPct: latest.progressPct,
            speedKmh: latest.speedKmh,
          });
          setStatusMessage(
            `Connectivity restored: flushed ${queuedUpdates.length} queued GPS packet(s) to backend.`
          );
          setQueuedUpdates([]);
        } finally {
          setBusy(false);
        }
      }
    } else {
      setOfflineMode(true);
      setStatusMessage('Offline mode active: GPS packets will buffer safely until network returns.');
    }
  };

  const handleStartTrip = async () => {
    setBusy(true);
    try {
      await post(`/api/trips/${trip.id}/start`);
      setStatusMessage('Trip started. Live GPS broadcasting is now active.');
    } finally {
      setBusy(false);
    }
  };

  const handleEndTrip = async () => {
    setBusy(true);
    try {
      await post(`/api/trips/${trip.id}/end`);
      setQueuedUpdates([]);
      setStatusMessage('Trip completed. GPS broadcasting stopped per compliance rules.');
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="h-[100dvh] w-full overflow-hidden bg-[#E8EEF4] flex justify-center md:items-center md:px-4 md:py-7">
      {/* On desktop, present the responsive app inside a phone device frame.
          On real mobile screens, the device frame disappears and the app fills the viewport. */}
      <div className="relative mx-auto flex h-full min-h-0 w-full max-w-[360px] min-w-0 flex-col overflow-hidden bg-[#142B50] text-slate-900 shadow-none md:h-[min(844px,calc(100dvh-56px))] md:min-h-[680px] md:rounded-[42px] md:border-[8px] md:border-[#142B50] md:shadow-[0_24px_70px_rgba(15,35,65,0.28)]">
      <div className="relative flex h-full min-h-0 w-full min-w-0 flex-1 flex-col overflow-hidden bg-[#F4F7FB] md:rounded-[33px]">
      {/* Simulated phone status bar: part of the app preview, not a PWA/browser bar */}
      <div aria-hidden="true" className="pointer-events-none absolute left-1/2 top-0 z-[80] hidden h-[26px] w-[104px] -translate-x-1/2 rounded-b-[16px] bg-[#142B50] md:block" />
      <div className="sticky top-0 z-[60] flex h-8 shrink-0 items-center justify-between bg-[#F4F7FB] px-6 text-[11px] font-semibold tracking-wide text-[#17324D]">
        <span>9:41</span>
        <div className="flex items-center gap-1.5">
          <span className="text-[10px]">5G</span>
          <span aria-label="Full battery" className="inline-flex items-center gap-0.5">
            <span className="h-[9px] w-[17px] rounded-[3px] border border-current p-[1px]"><span className="block h-full w-full rounded-[1px] bg-current" /></span>
            <span className="h-[4px] w-[2px] rounded-r-sm bg-current" />
          </span>
        </div>
      </div>
      <div className="min-h-0 min-w-0 flex-1 space-y-4 overflow-y-auto overscroll-y-contain touch-pan-y px-4 pb-36 pt-4 [scrollbar-width:thin] [scrollbar-color:#CBD5E1_transparent] md:scrollbar-thin">
      {/* Premium native-app header */}
      <div className="flex items-center justify-between rounded-[22px] border border-white/80 bg-white/75 px-3 py-3 shadow-[0_6px_22px_rgba(15,35,65,0.05)] backdrop-blur-sm">
        <div className="flex items-center gap-3">
          <div className="h-11 w-11 rounded-2xl bg-[#102A43] text-white flex items-center justify-center shadow-lg shadow-slate-300/60"><Bus className="h-5 w-5" /></div>
          <div><div className="text-[17px] font-extrabold tracking-tight text-[#102A43]">RouteStop</div><div className="text-[11px] font-medium text-slate-500">Driver companion</div></div>
        </div>
        <button type="button" aria-label="Notifications" className="relative h-10 w-10 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-700 shadow-sm"><Bell className="h-[18px] w-[18px]" /><span className="absolute right-2 top-2 h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white" /></button>
      </div>
      <div className="flex items-center justify-between px-1 pt-1">
        <div><p className="text-xs text-slate-500">Good day,</p><h1 className="text-xl font-extrabold tracking-tight text-[#102A43]">{crewMode === 'DRIVER' ? driver?.name.split(' ')[0] : conductor?.name.split(' ')[0]}</h1></div>
        <span className={`rounded-full px-3 py-1.5 text-[10px] font-bold tracking-wide ${trip.status === 'IN_PROGRESS' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}`}><span className="mr-1 inline-block h-1.5 w-1.5 rounded-full bg-current" />{trip.status.replace(/_/g, ' ')}</span>
      </div>
      {/* Assigned trip card */}
      <div className="min-w-0 bg-white border border-slate-200/80 rounded-[24px] p-4 shadow-[0_10px_28px_rgba(15,35,65,0.07)] flex flex-col gap-4 ring-1 ring-white">
        <div className="flex min-w-0 w-full xl:w-auto items-start sm:items-center gap-3 sm:gap-4">
          <div className="w-11 h-11 rounded-2xl bg-[#102A43] text-white flex items-center justify-center shrink-0 shadow-md">
            <Bus className="w-5 h-5" />
          </div>
          <div className="min-w-0 flex-1">
            <div className="text-[10px] uppercase tracking-[0.12em] font-bold text-slate-400 break-words">
              {company?.name} · Assigned Vehicle & Trip
            </div>
            <select
              value={trip.id}
              onChange={(e) => {
                setSelectedTripId(e.target.value);
                setQueuedUpdates([]);
                setStatusMessage(null);
              }}
              aria-label="Select Assigned Trip"
              className="block w-full max-w-full min-w-0 truncate text-[14px] font-extrabold text-[#102A43] bg-transparent border-0 pb-1 pr-5 mt-1 focus:outline-none focus:ring-0"
            >
              {state.trips.map((t) => {
                const v = state.vehicles.find((veh) => veh.id === t.vehicleId);
                const r = state.routes.find((rt) => rt.id === t.routeId);
                return (
                  <option key={t.id} value={t.id}>
                    {v?.regNumber} — {r?.name} ({t.status})
                  </option>
                );
              })}
            </select>
          </div>
        </div>

        <div className="flex min-w-0 w-full xl:w-auto flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
          {/* Crew Role Switch */}
          <div className="grid grid-cols-2 items-center gap-1 p-1.5 bg-[#F1F5F9] rounded-2xl w-full">
            <button
              type="button"
              onClick={() => setCrewMode('DRIVER')}
              className={`px-2 py-3 text-[11px] font-bold rounded-xl transition-colors ${
                crewMode === 'DRIVER' ? 'bg-white text-[#102A43] shadow-sm' : 'text-slate-500'
              }`}
            >
              Driver Mode ({driver?.name.split(' ')[0]})
            </button>
            <button
              type="button"
              onClick={() => setCrewMode('CONDUCTOR')}
              className={`px-2 py-3 text-[11px] font-bold rounded-xl transition-colors ${
                crewMode === 'CONDUCTOR' ? 'bg-white text-[#102A43] shadow-sm' : 'text-slate-500'
              }`}
            >
              Conductor Mode ({conductor?.name.split(' ')[0]})
            </button>
          </div>

          {/* Trip Lifecycle CTA */}
          {trip.status === 'ASSIGNED' || trip.status === 'READY_TO_START' ? (
            <button
              type="button"
              disabled={busy}
              onClick={handleStartTrip}
              className="w-full min-h-[50px] px-4 rounded-2xl bg-emerald-700 text-white text-sm font-extrabold hover:bg-emerald-800 inline-flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/15"
            >
              <Play className="w-3.5 h-3.5" /> Start Trip & Enable GPS
            </button>
          ) : trip.status === 'IN_PROGRESS' ? (
            <button
              type="button"
              disabled={busy}
              onClick={handleEndTrip}
              className="w-full min-h-[50px] px-4 rounded-2xl bg-rose-600 text-white text-sm font-extrabold hover:bg-rose-700 inline-flex items-center justify-center gap-2 shadow-lg shadow-rose-900/15"
            >
              <Square className="w-3.5 h-3.5" /> End Trip & Stop GPS
            </button>
          ) : (
            <span className="px-3.5 py-2 rounded-lg bg-slate-100 text-slate-600 text-xs font-semibold">
              Trip Completed
            </span>
          )}
        </div>
      </div>

      {statusMessage && (
        <div className="bg-[#102A43] text-white rounded-2xl px-4 py-3 text-xs flex flex-col gap-2 min-w-0 shadow-md">
          <span className="min-w-0 break-words">{statusMessage}</span>
          <button type="button" onClick={() => setStatusMessage(null)} className="text-slate-400 hover:text-white">
            Dismiss
          </button>
        </div>
      )}

      {activeTab === 'home' && (
      <>
      {/* Primary KPI & Next Restaurant Strip */}
      <div className="grid grid-cols-2 gap-3">
        <div className="min-w-0 bg-white border border-slate-100 rounded-[20px] p-3.5 shadow-[0_5px_18px_rgba(15,23,42,0.04)]">
          <div className="text-[10px] uppercase tracking-wide font-bold text-slate-400">Trip State</div>
          <div className="text-[15px] leading-tight break-words font-extrabold text-[#102A43] mt-2">{trip.status.replace(/_/g, ' ')}</div>
          <div className="text-xs text-slate-500 mt-1 font-mono tabular-nums">
            {vehicle.type} · {vehicle.seatingCapacity} seats
          </div>
        </div>

        <div className="min-w-0 bg-white border border-slate-100 rounded-[20px] p-3.5 shadow-[0_5px_18px_rgba(15,23,42,0.04)]">
          <div className="text-[10px] uppercase tracking-wide font-bold text-slate-400">Next Partner Restaurant</div>
          <div className="text-[15px] leading-tight font-extrabold text-[#102A43] mt-2 truncate">
            {nextRestaurant ? nextRestaurant.name : 'End of Route'}
          </div>
          <div className="text-xs text-emerald-700 font-medium mt-1">
            {nextRestaurantStop ? nextRestaurantStop.stopName : route.destination}
          </div>
        </div>

        <div className="min-w-0 bg-white border border-slate-100 rounded-[20px] p-3.5 shadow-[0_5px_18px_rgba(15,23,42,0.04)]">
          <div className="text-[10px] uppercase tracking-wide font-bold text-slate-400">Distance & ETA to Stop</div>
          <div className="text-[17px] leading-tight break-words font-extrabold font-mono tabular-nums text-[#102A43] mt-2">
            {nextRestaurantStop ? `${nextRestaurantStop.distanceRemainingKm} km` : '0 km'}
          </div>
          <div className="text-xs font-mono tabular-nums text-emerald-700 font-semibold mt-1">
            {nextRestaurantStop ? `ETA ${nextRestaurantStop.etaMinutes} mins` : 'Arrived'}
          </div>
        </div>

        <div className="min-w-0 bg-white border border-slate-100 rounded-[20px] p-3.5 shadow-[0_5px_18px_rgba(15,23,42,0.04)]">
          <div className="text-[10px] uppercase tracking-wide font-bold text-slate-400">Active Passenger Pre-Orders</div>
          <div className="text-[17px] leading-tight break-words font-extrabold font-mono tabular-nums text-[#102A43] mt-2">
            {tripOrders.filter((o) => o.status !== 'COMPLETED').length} Pending
          </div>
          <div className="text-xs text-slate-500 mt-1 font-mono tabular-nums">
            {tripOrders.filter((o) => o.status === 'READY').length} Ready for Pickup
          </div>
        </div>
      </div>

      {/* Live Map */}
      <div className="w-full min-w-0 overflow-hidden rounded-[22px] border border-slate-100 bg-white p-2 shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
      <RouteMapVisualizer
        route={route}
        trip={trip}
        restaurants={state.restaurants}
        highlightedRestaurantId={nextRestaurant?.id}
      />
      </div>
      </>
      )}

      {activeTab !== 'home' && activeTab !== 'profile' && (
        <div className="px-1 pt-1">
          <p className="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-700">RouteStop workspace</p>
          <h2 className="mt-1 text-2xl font-extrabold tracking-tight text-[#102A43]">{activeTab === 'gps' ? 'Live tracking' : activeTab === 'trips' ? 'Your route' : 'Passenger orders'}</h2>
          <p className="mt-1 text-xs text-slate-500">{activeTab === 'gps' ? 'Monitor and update your trip location' : activeTab === 'trips' ? 'Stops and restaurant information' : 'Manage passenger pickup and collection'}</p>
        </div>
      )}

      {/* Driver GPS and route-stop screens */}
      {activeTab !== 'orders' && activeTab !== 'home' && activeTab !== 'profile' ? (
        <div className="grid grid-cols-1 gap-4 sm:gap-6">
          {/* GPS Telemetry Controls */}
          {activeTab === 'gps' && <div className="min-w-0 bg-white border border-slate-100 rounded-[24px] p-4 space-y-5 shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
            <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <h2 className="text-lg font-extrabold tracking-tight text-[#102A43]">Live GPS Broadcast Controls</h2>
                <p className="text-xs text-slate-500 mt-0.5">
                  Push live coordinates along {route.code} to update restaurant & passenger ETAs.
                </p>
              </div>
              <button
                type="button"
                onClick={handleToggleOffline}
                className={`px-3 py-1.5 rounded-lg text-xs font-medium inline-flex items-center gap-1.5 border ${
                  offlineMode
                    ? 'bg-amber-50 border-amber-300 text-amber-900'
                    : 'bg-slate-50 border-slate-200 text-slate-700'
                }`}
              >
                {offlineMode ? <WifiOff className="w-3.5 h-3.5" /> : <Wifi className="w-3.5 h-3.5" />}
                {offlineMode ? `Offline (${queuedUpdates.length})` : 'Network Online'}
              </button>
            </div>

            {trip.status !== 'IN_PROGRESS' ? (
              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600">
                GPS broadcasting is locked. {trip.status === 'COMPLETED' ? 'Completed trips cannot broadcast GPS.' : 'Click "Start Trip & Enable GPS" above to begin sending coordinates.'}
              </div>
            ) : (
              <div className="space-y-4">
                <div>
                  <div className="flex justify-between text-xs mb-1.5">
                    <span className="text-slate-600">Route Progress</span>
                    <span className="font-mono font-semibold tabular-nums text-slate-900">
                      {trip.progressPct}% ({trip.currentKm} / {route.totalKm} km)
                    </span>
                  </div>
                  <input
                    type="range"
                    min={0}
                    max={100}
                    value={trip.progressPct}
                    onChange={(e) => pushGpsUpdate(Number(e.target.value))}
                    className="w-full accent-emerald-600 cursor-pointer"
                  />
                </div>

                <div className="grid grid-cols-2 gap-2.5">
                  <div>
                    <label className="block text-xs font-medium text-slate-700 mb-1">
                      Cruising Speed (km/h)
                    </label>
                    <input
                      type="number"
                      min={25}
                      max={105}
                      value={speedKmh}
                      onChange={(e) => setSpeedKmh(Number(e.target.value) || 65)}
                      className="w-full border border-slate-200 rounded-lg px-3 py-2 text-xs font-mono"
                    />
                  </div>
                  <div className="flex items-end">
                    <button
                      type="button"
                      disabled={busy}
                      onClick={() => pushGpsUpdate(Math.min(100, trip.progressPct + 6))}
                      className="w-full min-h-[38px] rounded-lg bg-slate-900 text-white text-xs font-medium hover:bg-slate-800 inline-flex items-center justify-center gap-1.5"
                    >
                      <Navigation className="w-3.5 h-3.5" /> Drive +25 km
                    </button>
                  </div>
                </div>

                <div className="p-3 rounded-lg bg-slate-50 border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono tabular-nums">
                  <div>
                    <span className="text-slate-400 block">Latitude</span>
                    <span className="text-slate-900">{trip.currentLat.toFixed(4)}</span>
                  </div>
                  <div>
                    <span className="text-slate-400 block">Longitude</span>
                    <span className="text-slate-900">{trip.currentLng.toFixed(4)}</span>
                  </div>
                  <div>
                    <span className="text-slate-400 block">Heading</span>
                    <span className="text-slate-900 flex items-center gap-1">
                      <Compass className="w-3 h-3" /> {trip.headingDeg}°
                    </span>
                  </div>
                </div>
              </div>
            )}
          </div>}

          {/* Upcoming Partner Stops & Order Counts */}
          {activeTab === 'trips' && <div className="min-w-0 bg-white border border-slate-100 rounded-[24px] p-4 shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
            <h2 className="text-lg font-extrabold tracking-tight text-[#102A43] mb-4">
              Upcoming Partner Stops & Order Summary
            </h2>
            <div className="divide-y divide-slate-100">
              {trip.stopEtas.map((stopEta) => {
                const rest = stopEta.restaurantId
                  ? state.restaurants.find((r) => r.id === stopEta.restaurantId)
                  : null;
                const stopOrders = stopEta.restaurantId
                  ? tripOrders.filter((o) => o.restaurantId === stopEta.restaurantId)
                  : [];
                const dineInCount = stopOrders.filter((o) => o.orderType === 'DINE_IN').length;
                const takeawayCount = stopOrders.filter((o) => o.orderType === 'TAKEAWAY').length;

                return (
                  <div key={stopEta.stopId} className="py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 min-w-0">
                    <div className="flex items-start gap-3">
                      <MapPin
                        className={`w-4 h-4 mt-0.5 shrink-0 ${
                          stopEta.passed
                            ? 'text-slate-300'
                            : rest
                              ? 'text-emerald-600'
                              : 'text-slate-400'
                        }`}
                      />
                      <div>
                        <div className="text-sm font-semibold text-slate-900">
                          {rest ? rest.name : stopEta.stopName}
                        </div>
                        <div className="text-xs text-slate-500">
                          {stopEta.stopName} · Marker {stopEta.kmFromOrigin} km
                        </div>
                      </div>
                    </div>

                    <div className="flex flex-wrap items-center justify-between sm:justify-end gap-3 sm:gap-5 text-xs">
                      {rest && (
                        <div className="text-right">
                          <div className="font-semibold text-slate-900 font-mono tabular-nums">
                            {stopOrders.length} Orders
                          </div>
                          <div className="text-slate-500">
                            {dineInCount} Dine-in · {takeawayCount} Takeaway
                          </div>
                        </div>
                      )}
                      <div className="w-24 text-right font-mono tabular-nums">
                        {stopEta.passed ? (
                          <span className="text-slate-400">Passed</span>
                        ) : stopEta.kmFromOrigin === 0 ? (
                          <span className="text-slate-500">Origin</span>
                        ) : (
                          <>
                            <div className="font-semibold text-emerald-700">{stopEta.etaMinutes} mins</div>
                            <div className="text-slate-500">{stopEta.distanceRemainingKm} km</div>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>}
        </div>
      ) : (
        /* CONDUCTOR ASSIST VIEW */
        <div className="bg-white border border-slate-100 rounded-[24px] overflow-hidden min-w-0 shadow-[0_8px_24px_rgba(15,23,42,0.05)]">
          <div className="px-3 sm:px-5 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div className="flex items-center gap-2">
              <Users className="w-4 h-4 text-slate-600" />
              <h2 className="text-lg font-extrabold tracking-tight text-[#102A43]">
                Conductor Passenger Order Assist ({tripOrders.length})
              </h2>
            </div>
            <span className="text-xs text-slate-500">
              Authorized to assist passengers & confirm collection at restaurant stops
            </span>
          </div>

          {tripOrders.length === 0 ? (
            <div className="p-10 text-center text-xs text-slate-500">
              No active passenger orders on this trip yet.
            </div>
          ) : (
            <>
              <div className="md:hidden p-3 space-y-3">
                {tripOrders.map((ord) => {
                  const rest = state.restaurants.find((r) => r.id === ord.restaurantId);
                  return (
                    <article key={ord.id} className="min-w-0 rounded-[20px] border border-slate-100 bg-white p-4 space-y-3 shadow-sm">
                      <div className="flex min-w-0 items-start justify-between gap-2">
                        <div className="min-w-0">
                          <div className="text-[10px] uppercase tracking-wide text-slate-500">Order / Code</div>
                          <div className="break-all text-xs font-mono font-semibold text-slate-900">{ord.id}</div>
                          <div className="text-xs font-mono text-emerald-700">Code {ord.pickupCode}</div>
                        </div>
                        <span className={`shrink-0 rounded-full px-2 py-1 text-[10px] font-semibold ${
                          ord.status === 'READY' ? 'bg-emerald-50 text-emerald-700' :
                          ord.status === 'COMPLETED' ? 'bg-slate-100 text-slate-600' :
                          'bg-amber-50 text-amber-700'
                        }`}>{ord.status}</span>
                      </div>
                      <div className="grid grid-cols-2 gap-3 text-xs">
                        <div className="min-w-0">
                          <div className="text-[10px] text-slate-500">Passenger & Seat</div>
                          <div className="break-words font-medium text-slate-900">{ord.passengerName}</div>
                          <div className="break-words text-slate-500">Seat {ord.seatNumber || '—'}</div>
                          <div className="break-all text-slate-500">{ord.passengerPhone}</div>
                        </div>
                        <div className="min-w-0">
                          <div className="text-[10px] text-slate-500">Restaurant Stop</div>
                          <div className="break-words font-medium text-slate-900">{rest?.name || '—'}</div>
                          <div className="break-words text-slate-500">{rest?.city}</div>
                          <div className="text-slate-500">Mode: {ord.orderType}</div>
                        </div>
                      </div>
                      {ord.status === 'READY' ? (
                        <button
                          type="button"
                          onClick={() =>
                            patch(`/api/orders/${ord.id}/status`, {
                              status: 'COMPLETED',
                              actorRole: 'CONDUCTOR',
                            })
                          }
                          className="w-full min-h-[40px] px-3 py-2 rounded-xl bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 inline-flex items-center justify-center gap-1 shadow-sm"
                        >
                          <CheckCircle2 className="w-3.5 h-3.5" /> Confirm Collection
                        </button>
                      ) : ord.status === 'COMPLETED' ? (
                        <div className="text-center text-xs text-slate-500 py-1">Collected</div>
                      ) : (
                        <div className="text-center text-xs text-slate-400 py-1 inline-flex items-center justify-center gap-1 w-full">
                          <Clock className="w-3 h-3" /> In Kitchen
                        </div>
                      )}
                    </article>
                  );
                })}
              </div>
              <div className="hidden md:block overflow-x-auto">
              <table className="w-full min-w-[760px] text-left text-xs">
                <thead className="bg-slate-50 text-slate-500 border-b border-slate-200">
                  <tr>
                    <th className="py-3 px-4 font-medium">Order / Code</th>
                    <th className="py-3 px-4 font-medium">Passenger & Seat</th>
                    <th className="py-3 px-4 font-medium">Restaurant Stop</th>
                    <th className="py-3 px-4 font-medium">Mode</th>
                    <th className="py-3 px-4 font-medium">Status</th>
                    <th className="py-3 px-4 font-medium text-right">Conductor Action</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {tripOrders.map((ord) => {
                    const rest = state.restaurants.find((r) => r.id === ord.restaurantId);
                    return (
                      <tr key={ord.id} className="hover:bg-slate-50/60">
                        <td className="py-3 px-4 font-mono">
                          <div className="font-semibold text-slate-900">{ord.id}</div>
                          <div className="text-emerald-700">Code {ord.pickupCode}</div>
                        </td>
                        <td className="py-3 px-4">
                          <div className="font-medium text-slate-900">{ord.passengerName}</div>
                          <div className="text-slate-500">Seat {ord.seatNumber || '—'} · {ord.passengerPhone}</div>
                        </td>
                        <td className="py-3 px-4">
                          <div className="font-medium text-slate-900">{rest?.name}</div>
                          <div className="text-slate-500">{rest?.city}</div>
                        </td>
                        <td className="py-3 px-4">{ord.orderType}</td>
                        <td className="py-3 px-4 font-medium">
                          <span
                            className={
                              ord.status === 'READY'
                                ? 'text-emerald-700'
                                : ord.status === 'COMPLETED'
                                  ? 'text-slate-500'
                                  : 'text-amber-700'
                            }
                          >
                            {ord.status}
                          </span>
                        </td>
                        <td className="py-3 px-4 text-right">
                          {ord.status === 'READY' ? (
                            <button
                              type="button"
                              onClick={() =>
                                patch(`/api/orders/${ord.id}/status`, {
                                  status: 'COMPLETED',
                                  actorRole: 'CONDUCTOR',
                                })
                              }
                              className="px-3 py-1.5 rounded-lg bg-emerald-700 text-white text-xs font-medium hover:bg-emerald-800 inline-flex items-center gap-1"
                            >
                              <CheckCircle2 className="w-3.5 h-3.5" /> Confirm Collection
                            </button>
                          ) : ord.status === 'COMPLETED' ? (
                            <span className="text-slate-400">Collected</span>
                          ) : (
                            <span className="text-slate-400 inline-flex items-center gap-1">
                              <Clock className="w-3 h-3" /> In Kitchen
                            </span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              </div>
            </>
          )}
        </div>
      )}

      {activeTab === 'profile' && (
        <section className="space-y-3">
          <div className="rounded-[22px] bg-white border border-slate-100 p-4 shadow-[0_6px_20px_rgba(15,23,42,0.05)]">
            <div className="flex items-center gap-3">
              <div className="h-14 w-14 rounded-2xl bg-[#102A43] text-white flex items-center justify-center"><UserRound className="h-7 w-7" /></div>
              <div className="min-w-0"><h2 className="font-bold text-slate-900">{crewMode === 'DRIVER' ? driver?.name : conductor?.name}</h2><p className="text-xs text-slate-500">{crewMode === 'DRIVER' ? 'Driver' : 'Conductor'} · {company?.name}</p></div>
            </div>
          </div>
          <div className="rounded-[22px] bg-white border border-slate-100 p-4 shadow-[0_6px_20px_rgba(15,23,42,0.05)] space-y-3">
            <h3 className="font-semibold text-sm">Vehicle & Trip Details</h3>
            <div className="flex justify-between gap-3 text-sm"><span className="text-slate-500">Vehicle</span><strong>{vehicle.regNumber}</strong></div>
            <div className="flex justify-between gap-3 text-sm"><span className="text-slate-500">Vehicle type</span><strong>{vehicle.type}</strong></div>
            <div className="flex justify-between gap-3 text-sm"><span className="text-slate-500">Seats</span><strong>{vehicle.seatingCapacity}</strong></div>
            <div className="flex justify-between gap-3 text-sm"><span className="text-slate-500">Route</span><strong className="text-right">{route.name}</strong></div>
          </div>
          <div className="rounded-[22px] bg-white border border-slate-100 p-4 shadow-[0_6px_20px_rgba(15,23,42,0.05)] space-y-2">
            <h3 className="font-semibold text-sm">Switch Workspace</h3>
            <div className="grid grid-cols-2 gap-2">
              <button type="button" onClick={() => setCrewMode('DRIVER')} className={`rounded-xl border px-3 py-3 text-xs font-semibold ${crewMode === 'DRIVER' ? 'border-emerald-600 bg-emerald-50 text-emerald-800' : 'border-slate-200 text-slate-600'}`}>Driver Mode</button>
              <button type="button" onClick={() => setCrewMode('CONDUCTOR')} className={`rounded-xl border px-3 py-3 text-xs font-semibold ${crewMode === 'CONDUCTOR' ? 'border-emerald-600 bg-emerald-50 text-emerald-800' : 'border-slate-200 text-slate-600'}`}>Conductor Mode</button>
            </div>
          </div>
        </section>
      )}

      {/* Persistent app bottom navigation */}
      <nav className="fixed bottom-0 left-1/2 z-50 w-full max-w-[360px] -translate-x-1/2 px-3 pb-[max(0.65rem,env(safe-area-inset-bottom))] pt-2 pointer-events-none md:absolute md:bottom-0">
        <div className="mx-auto grid w-full grid-cols-5 gap-1 rounded-[23px] border border-white bg-white/95 px-2 py-2.5 shadow-[0_14px_38px_rgba(15,35,65,0.18)] backdrop-blur-xl pointer-events-auto">
          {[
            { id: 'home' as const, label: 'Home', Icon: Home },
            { id: 'trips' as const, label: 'Trips', Icon: Route },
            { id: 'gps' as const, label: 'Live GPS', Icon: MapPinned },
            { id: 'orders' as const, label: 'Orders', Icon: ClipboardList },
            { id: 'profile' as const, label: 'Profile', Icon: UserRound },
          ].map(({ id, label, Icon }) => (
            <button key={id} type="button" onClick={() => { setActiveTab(id); if (id === 'orders') setCrewMode('CONDUCTOR'); if (id === 'gps' || id === 'trips') setCrewMode('DRIVER'); }} className={`flex min-w-0 flex-col items-center justify-center gap-1 rounded-2xl py-1.5 text-[10px] font-bold transition-all ${activeTab === id ? 'text-emerald-800' : 'text-slate-400 hover:text-slate-700'}`}>
              <span className={`flex h-9 w-11 items-center justify-center rounded-2xl transition-colors ${activeTab === id ? 'bg-emerald-50 ring-1 ring-emerald-100' : ''}`}><Icon className="h-5 w-5" /></span>
              <span>{label}</span>
            </button>
          ))}
        </div>
      </nav>
      </div>
      </div>
      </div>
    </div>
  );
}
